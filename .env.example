# Microsoft Edge Add-ons API Credentials
# Get these from Partner Center > Microsoft Edge > Publish API
CLIENT_ID=your-client-id-here
API_KEY=your-api-key-here

# Your extension's Product ID
# Get this from Partner Center > Microsoft Edge > Overview > Select your extension
PRODUCT_ID=your-product-id-here

# Optional: API endpoint (defaults to production)
API_ENDPOINT=https://api.addons.microsoftedge.microsoft.com
